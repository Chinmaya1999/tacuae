# Default (no domain yet): plain HTTP on the server IP — site A :80, site B :8081, site C :8082.
# With domains: set MAIN_SITE / B_SITE / C_SITE in /opt/tac/.env (e.g. MAIN_SITE="tacuae.com, www.tacuae.com")
# and Caddy obtains HTTPS certificates automatically.
(common) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$MAIN_SITE:http://:80} {
	import common
	reverse_proxy tac-main:3000
}
{$B_SITE:http://:8081} {
	import common
	reverse_proxy tac-b:3000
}
{$C_SITE:http://:8082} {
	import common
	reverse_proxy tac-c:3000
}
