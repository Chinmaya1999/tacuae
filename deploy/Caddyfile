# Default (no domain yet): plain HTTP on the server IP, port 8082.
# With a domain: set C_SITE in /opt/tac/.env (e.g. C_SITE="tacuae.com, www.tacuae.com") and Caddy obtains HTTPS automatically.
(common) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$C_SITE:http://:8082} {
	import common
	reverse_proxy tac-c:3000
}
