# Copy to .env (git-ignored). Only MONGODB_URI is needed for customer/builder/admin accounts.
PORT=8787
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=<app>
# First admin (created on first start when none exists). Leave ADMIN_PASSWORD empty to get a random one printed once.
ADMIN_EMAIL=admin@tacuae.com
ADMIN_PASSWORD=
# Google sign-in: OAuth client ID (Web application). Leave empty to hide the button. No client secret is needed.
GOOGLE_CLIENT_ID=
# Mobile (SMS) sign-in: the Firebase web app config. Set all four to switch it on. Never put a service account here.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Optional
SESSION_SECRET=
TRUST_PROXY=false
CORS_ORIGINS=
ENQUIRY_TO=info@tacuae.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
